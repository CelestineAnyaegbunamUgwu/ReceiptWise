
erDiagram
    USERS ||--o{ USER_ROLES : has
    ROLES ||--o{ USER_ROLES : assigned
    USERS ||--o{ RECEIPTS : uploads

    RECEIPTS ||--o{ EXTRACTION_RUNS : processes
    EXTRACTION_RUNS ||--o{ EXTRACTED_FIELDS : produces
    EXTRACTED_FIELDS ||--o{ FIELD_CORRECTIONS : receives

    RECEIPTS ||--o| EXPENSES : generates
    USERS ||--o{ EXPENSES : submits

    EXPENSES ||--o{ APPROVAL_DECISIONS : receives
    USERS ||--o{ APPROVAL_DECISIONS : makes

    ROLES ||--o{ EXPENSE_POLICY_RULES : authorizes

    USERS o|--o{ AUDIT_EVENTS : performs

    USERS {
        uuid id PK
        string full_name
        string email UK
        string password_hash
        boolean is_active
    }

    ROLES {
        uuid id PK
        string name UK
        string description
    }

    USER_ROLES {
        uuid user_id PK, FK
        uuid role_id PK, FK
    }

    RECEIPTS {
        uuid id PK
        uuid uploaded_by FK
        string storage_key
        string sha256_hash
        string processing_status
    }

    EXTRACTION_RUNS {
        uuid id PK
        uuid receipt_id FK
        string engine_name
        string engine_version
        json raw_output
    }

    EXTRACTED_FIELDS {
        uuid id PK
        uuid extraction_run_id FK
        string field_name
        string raw_text
        string normalized_value
        decimal confidence
        json bounding_box
    }

    FIELD_CORRECTIONS {
        uuid id PK
        uuid extracted_field_id FK
        uuid corrected_by FK
        string previous_value
        string corrected_value
    }

    EXPENSES {
        uuid id PK
        uuid receipt_id FK
        uuid employee_id FK
        string category
        decimal subtotal
        decimal tax
        decimal total
    }

    EXPENSE_POLICY_RULES {
        uuid id PK
        string category
        decimal maximum_amount
        string currency
        uuid approver_role_id FK
    }

    APPROVAL_DECISIONS {
        uuid id PK
        uuid expense_id FK
        uuid decided_by FK
        string decision
        string comments
    }

    AUDIT_EVENTS {
        uuid id PK
        uuid actor_id FK
        string entity_type
        uuid entity_id
        string action
    }
EXPENSES ||--o{ FINANCIAL_VALIDATIONS : validates
EXPENSES ||--o{ POLICY_EVALUATIONS : evaluates
EXPENSE_POLICY_RULES ||--o{ POLICY_EVALUATIONS : governs
FINANCIAL_VALIDATIONS {
    uuid id PK
    uuid expense_id FK
    decimal subtotal_calculated
    decimal tax_calculated
    decimal expected_total
    decimal extracted_total
    decimal discrepancy
    string validation_status
    json validation_details
}

POLICY_EVALUATIONS {
    uuid id PK
    uuid expense_id FK
    uuid policy_rule_id FK
    integer policy_version
    decimal expense_amount
    string currency
    string evaluation_result
    json evaluation_details
}